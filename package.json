{
  "name": "prisma-sqlmodel-gen",
  "version": "0.1.5",
  "description": "Generate SQLModel table models from a Prisma schema",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "prisma",
    "sqlmodel",
    "python",
    "typescript",
    "codegen",
    "postgresql",
    "mysql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganesh-rao/prisma-sqlmodel-gen.git"
  },
  "homepage": "https://github.com/ganesh-rao/prisma-sqlmodel-gen#readme",
  "bugs": {
    "url": "https://github.com/ganesh-rao/prisma-sqlmodel-gen/issues"
  },
  "main": "./dist/generator.cjs",
  "module": "./dist/generator.js",
  "types": "./dist/generator.d.ts",
  "bin": {
    "prisma-sqlmodel-gen": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js",
      "require": "./dist/generator.cjs",
      "default": "./dist/generator.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs",
      "default": "./dist/cli.js"
    },
    "./bin": {
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js",
      "require": "./dist/bin.cjs",
      "default": "./dist/bin.js"
    },
    "./generator": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js",
      "require": "./dist/generator.cjs",
      "default": "./dist/generator.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "test:all": "npm run check && npm test && npm run test:integration",
    "prepublishOnly": "npm run clean && npm run test:all && npm run build"
  },
  "dependencies": {
    "@mrleebo/prisma-ast": "^0.15.0",
    "@prisma/generator-helper": "^7.7.0",
    "@prisma/internals": "^7.7.0"
  },
  "devDependencies": {
    "@prisma/adapter-mariadb": "^7.7.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "mariadb": "^3.4.5",
    "pg": "^8.16.3",
    "prisma": "^7.7.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
